# ===== ClickTake Technologies — Environment Variables =====
# Copy this file to .env and fill in your values.

# Database (local dev = SQLite, production = Supabase PostgreSQL)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Public site URL (used by SEO audit + sitemap + canonical URLs)
NEXT_PUBLIC_SITE_URL=https://clicktaketech.com

# Environment
NODE_ENV=production

# ===== Optional integrations (leave blank to disable) =====

# Cloudinary (image storage + CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Analytics 4
GOOGLE_ANALYTICS_ID=

# Google Search Console verification
GOOGLE_SITE_VERIFICATION=

# Stripe (payments)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Email delivery (Resend / SendGrid / SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
