// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  password    String
  role        String   @default("admin")
  permissions String?  // JSON array of enabled permission keys; null = all (admin)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== CMS models =====

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String   @default("custom")
  status      String   @default("published") // published | draft
  hero        String?
  overview    String?
  body        String?  // markdown / rich text
  metaTitle       String?
  metaDescription String?
  keywords    String?  // comma separated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String   @default("General")
  excerpt     String
  body        String?
  status      String   @default("published") // published | draft
  readTime   String   @default("5 min")
  metaTitle       String?
  metaDescription String?
  keywords    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model PricingTier {
  id          String   @id @default(cuid())
  name        String   @unique
  tagline     String
  audience    String
  price       String
  cadence     String
  popular     Boolean  @default(false)
  features    String   // newline separated
  notIncluded String?  // newline separated
  cta         String
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactQuery {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  need      String?
  message   String?
  source    String   @default("contact") // contact | job-apply | chatbot
  status    String   @default("new") // new | read | replied | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
}

model JobApplication {
  id             String   @id @default(cuid())
  jobId          String
  positionType   String?
  fullName       String
  email          String
  mobile         String?
  filesFolder    String?  // upload/applications/<folder>
  filesManifest  String?  // pipe-separated list of saved files
  status         String   @default("new") // new | reviewed | shortlisted | rejected
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([jobId])
}

model SeoAudit {
  id          String   @id @default(cuid())
  url         String
  score       Int      @default(0)
  titleLen    Int      @default(0)
  descLen     Int      @default(0)
  h1Count     Int      @default(0)
  hasCanonical Boolean @default(false)
  hasOg       Boolean  @default(false)
  hasJsonLd   Boolean  @default(false)
  hasSitemap  Boolean  @default(false)
  hasRobots   Boolean  @default(false)
  issues      String?  // newline separated
  notes       String?
  createdAt   DateTime @default(now())
}

model MediaAsset {
  id        String   @id @default(cuid())
  name      String
  url       String
  mime      String
  size      Int      @default(0)
  alt       String?
  folder    String   @default("uploads")
  createdAt DateTime @default(now())

  @@index([folder])
  @@index([mime])
}

model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String
  status    Int      @default(301) // 301 | 302
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("general") // general | seo | contact | social | integrations
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String   // create | update | delete | login | logout | publish | draft
  entity    String   // page | blog | pricing | query | media | redirect | setting | user | application
  entityId  String?
  summary   String
  actor     String   @default("admin")
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

// ===== Advanced CMS models =====

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  source     String   @default("website") // website | chatbot | manual | referral
  stage      String   @default("new") // new | contacted | qualified | proposal | won | lost
  value      String?  // estimated deal value
  notes      String?
  tags       String?  // comma separated
  owner      String?  // assigned user email
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([stage])
  @@index([source])
  @@index([owner])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  subject   String
  body      String   // markdown / html
  category  String   @default("transactional") // transactional | marketing | autoresponder
  status    String   @default("draft") // draft | active
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model Experiment {
  id          String   @id @default(cuid())
  name        String
  hypothesis  String
  page        String   // which page/element
  variantA    String
  variantB    String
  metric      String   @default("conversion") // conversion | click | scroll
  status      String   @default("draft") // draft | running | completed | paused
  visitorsA   Int      @default(0)
  visitorsB   Int      @default(0)
  convA       Int      @default(0)
  convB       Int      @default(0)
  winner      String?  // A | B | null
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model ThemeVariable {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. --color-primary, --font-sans, --radius
  value     String
  category  String   @default("color") // color | font | radius | spacing
  updatedAt DateTime @updatedAt
}

model TypographyPreset {
  id         String   @id @default(cuid())
  name       String   @unique
  fontFamily String
  headingScale String  // e.g. "1.25"
  bodySize   String   // e.g. "16px"
  lineHeight String   // e.g. "1.6"
  active     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model SecurityLog {
  id        String   @id @default(cuid())
  type      String   // login | failed_login | logout | permission_denied | rate_limit | ip_block
  ip        String?
  email     String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model SiteVisit {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  country   String?
  device    String   @default("desktop") // desktop | mobile | tablet
  browser   String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([sessionId])
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  department  String
  bio         String?
  photo       String?  // URL to photo
  linkedin    String?
  twitter     String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([department])
}

model Job {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  department  String
  location    String
  type        String   @default("Full-time") // Full-time | Part-time | Internship | Contract
  description String
  requirements String? // newline separated
  salary      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([department])
}


